{
  "name": "nuskha",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "catalog": "node scripts/build-catalog.ts",
    "volumes": "node scripts/build-volumes.ts",
    "test": "vitest run",
    "epubcheck": "node scripts/epub-check.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "fonts": "python3 scripts/build-fonts.py",
    "size": "vite build && node scripts/size-report.ts",
    "pdfcheck": "node scripts/pdf-check.ts"
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "fflate": "^0.8.3",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@embedpdf/pdfium": "^2.15.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "pdfjs-dist": "^6.4.299",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
